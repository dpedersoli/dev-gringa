# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# secrets — values live in .env (never commit)
.env
.env.local
# .env.example is names-only and is committed

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local personal data (profile + evaluations + interview audio)
/data/*.json
/data/audio/
